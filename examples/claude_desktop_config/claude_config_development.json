{
  "mcpServers": {
    "cobalt-strike-dev": {
      "command": "uv",
      "args": [
        "--directory",
        "/home/user/cobaltstrike-mcp-server",
        "run",
        "--locked",
        "python",
        "cs_mcp.py",
        "--insecure",
        "--log-level", "DEBUG"
      ],
      "env": {
        "CS_API_USERNAME": "dev_user",
        "CS_API_PASSWORD": "dev_password",
        "LOG_LEVEL": "DEBUG"
      }
    }
  }
}
