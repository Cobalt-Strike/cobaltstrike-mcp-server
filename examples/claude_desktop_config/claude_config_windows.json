{
  "mcpServers": {
    "cobalt-strike-windows": {
      "command": "uv",
      "args": [
        "--directory",
        "C:/Users/YourUser/cobaltstrike-mcp-server",
        "run",
        "--locked",
        "python",
        "cs_mcp.py",
        "--insecure"
      ],
      "env": {
        "CS_API_USERNAME": "cs_user",
        "CS_API_PASSWORD": "cs_password",
        "CS_API_BASE_URL": "https://192.168.1.100:50443"
      }
    }
  }
}
